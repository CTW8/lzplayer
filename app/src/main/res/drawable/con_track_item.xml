<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/con_accent_soft"/>
            <stroke android:width="1dp" android:color="@color/con_accent"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/con_panel2"/>
            <stroke android:width="1dp" android:color="@color/con_line"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>
