<?xml version="1.0" encoding="utf-8"?>
<!--
  测试台主控台。布局顺序即操作顺序：选源 → 看画面与 HUD → 控播放 → 进面板。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/con_ground">

    <com.example.lzplayer.console.SmpteBarsView
        android:id="@+id/topBars"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>

    <!-- 源栏：本地路径与网络 URL 用同一个输入框，直接验 scheme 工厂分派 -->
    <LinearLayout
        android:id="@+id/sourceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/con_s3">

        <EditText
            android:id="@+id/etSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/con_panel_bg"
            android:paddingHorizontal="@dimen/con_s2"
            android:paddingVertical="@dimen/con_s2"
            android:fontFamily="monospace"
            android:textSize="@dimen/con_text_micro"
            android:textColor="@color/con_ink"
            android:textColorHint="@color/con_ink_faint"
            android:hint="文件路径或 http(s):// 地址"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:importantForAutofill="no"/>

        <TextView
            android:id="@+id/btnPickFile"
            style="@style/ConsoleButton"
            android:layout_marginStart="@dimen/con_s2"
            android:text="本地"/>

        <TextView
            android:id="@+id/btnOpen"
            style="@style/ConsolePrimaryButton"
            android:layout_marginStart="@dimen/con_s1"
            android:text="打开"/>
    </LinearLayout>

    <!-- 视频舞台 -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/con_video_void">

        <!-- 尺寸由 Activity 按视频显示宽高比算出(fit-inside)，
             四周留黑。硬解直出 Surface 时没有缩放环节，
             Surface 自身尺寸就决定画幅，match_parent 会把画面拉变形。 -->
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>

        <com.example.lzplayer.console.SubtitleOverlayView
            android:id="@+id/subtitleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- HUD 常驻：播放中随时能看到解码路径与状态，不必展开诊断 -->
        <LinearLayout
            android:id="@+id/hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/con_s2">

            <TextView
                android:id="@+id/chipDecoder"
                style="@style/ConsoleChip"
                android:text="—"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/chipState"
                style="@style/ConsoleChip"
                android:text="IDLE"/>
        </LinearLayout>

        <!-- 缓冲遮罩：网络源卡顿时出现 -->
        <LinearLayout
            android:id="@+id/bufferScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/con_scrim"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="@color/con_accent"/>

            <TextView
                android:id="@+id/tvBuffering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/con_s2"
                android:fontFamily="monospace"
                android:textSize="@dimen/con_text_micro"
                android:textColor="@color/con_ink"
                android:text="缓冲中"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 控制面板 -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/con_panel"
        android:padding="@dimen/con_s3">

        <!-- 第一层：进度行，播放键内嵌于此。
             先前那条全宽填充的暂停键是消费级播放器思路——测试台要密度不要
             大按钮，缩成圆钮嵌进来直接省掉一整行，竖向空间还给画面与仪表带。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnPlayPause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/con_play_round"
                android:textColor="#08191F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:text="▶"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/con_s3"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progressDrawable="@drawable/con_seekbar"
                    android:thumb="@drawable/con_seek_thumb"
                    android:splitTrack="false"
                    android:paddingHorizontal="0dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvPosition" style="@style/ConsoleReadoutSmall" android:text="00:00.000"/>
                    <TextView android:id="@+id/tvBuffered" style="@style/ConsoleReadoutSmall"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:gravity="center" android:text=""/>
                    <TextView android:id="@+id/tvDuration" style="@style/ConsoleReadoutSmall" android:text="00:00.000"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 第二层：面板入口，四等宽描边，样式完全一致。
             优先级只靠顺序表达(性能排第一)，不用颜色和尺寸强调——那正是
             上一版噪声的来源。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/con_s3">

            <TextView android:id="@+id/btnDiag" style="@style/ConsoleQuadButton" android:text="性能"/>
            <TextView android:id="@+id/btnTracks" style="@style/ConsoleQuadButton"
                android:layout_marginStart="@dimen/con_s2" android:text="轨道"/>
            <TextView android:id="@+id/btnSubtitle" style="@style/ConsoleQuadButton"
                android:layout_marginStart="@dimen/con_s2" android:text="字幕"/>
            <TextView android:id="@+id/btnJump" style="@style/ConsoleQuadButton"
                android:layout_marginStart="@dimen/con_s2" android:text="跳转"/>
        </LinearLayout>

        <!-- 第三层：次要控件，纯文字无框。
             停止的语义是破坏性的(按下去必须重开片源)，靠位置和字色降级，
             不给它专属样式——增加样式种类才是上一版乱的根源。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/con_s3"
            android:paddingHorizontal="@dimen/con_s2">

            <TextView android:id="@+id/btnLoop" style="@style/ConsoleMinorText" android:text="循环 关"/>
            <LinearLayout
                android:id="@+id/speedRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="horizontal"/>
            <TextView android:id="@+id/btnStop" style="@style/ConsoleMinorText"
                android:textColor="@color/con_crit" android:text="停止"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
